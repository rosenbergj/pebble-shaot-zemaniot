# Pebble build artifacts
build/
dist/
dist.zip
.lock-waf*
.wafpickle*

# Node / phone-side JS tooling
node_modules/

# Python
__pycache__/
*.pyc

# Emulator screenshots (dev-loop churn; force-add milestone shots if wanted)
screenshots/*.png
screenshots/*.gif

# Plan files live here (see .claude/settings.json) but are working documents that
# drift from the code; the README is the accurate record. The setting is committed,
# the plans are not.
.claude/plans/

# The original brief: private working material, kept outside the repo
design-idea.txt

# Machine-specific Claude settings (plansDirectory is an absolute path)
.claude/settings.local.json

# Personal release tooling: getting a build onto a wrist is a local matter
tools/local/

# Editor/OS noise
*.swp
.DS_Store

# Host C test harness artifacts
test/c/run_tests
test/c/fixtures.h

